{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otcs:wire:signal",
  "title": "OTCS Environmental Signal (wire format)",
  "type": "object",
  "required": ["signal_id", "signal_type", "subject", "value", "confidence", "freshness", "source", "scope"],
  "additionalProperties": false,
  "properties": {
    "signal_id": { "type": "string" },
    "signal_type": { "enum": ["system_health", "data_quality", "identity_confidence", "dependency_health", "threat_pressure", "ambiguity_load", "repair_capacity", "reversibility", "financial_exposure", "legal_context", "human_availability", "uncertainty", "cumulative_trajectory", "downstream_capacity"] },
    "subject": { "type": "string" },
    "value": { "type": ["number", "string", "boolean"] },
    "unit": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "self_attested": { "type": "boolean", "description": "true when the source shares the failure domain of the subject; consumers MUST treat as low-confidence" },
    "scope": { "type": "string" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "evidence_reference": { "type": "string" },
    "signature": { "type": "string" }
  }
}
