{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otcs:wire:receipt",
  "title": "OTCS Receipt (wire format)",
  "type": "object",
  "required": ["receipt_id", "decision_reference", "actor", "action", "target", "timestamp", "result", "enforcement_point", "evidence_hashes"],
  "additionalProperties": false,
  "properties": {
    "receipt_id": { "type": "string" },
    "decision_reference": { "type": "string" },
    "actor": { "type": "string" },
    "action": { "type": "string" },
    "target": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "result": { "enum": ["EXECUTED", "EXECUTED_SHAPED", "HANDED_TO_SUPERVISOR", "CONTAINED", "FAILED"] },
    "state_before": { "type": "string" },
    "state_after": { "type": "string" },
    "enforcement_point": { "type": "string" },
    "evidence_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "minItems": 1 },
    "external_anchor": { "type": "string", "description": "witness outside the governed actor's control" },
    "exceptions": { "type": "array", "items": { "type": "string" } }
  }
}
